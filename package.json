{
  "name": "yeelight-control",
  "productName": "Yeelight Control",
  "version": "1.1.0",
  "description": "Desktop app to control Yeelight / Xiaomi lamps over the local network.",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.yeelightcontrol",
    "productName": "Yeelight Control",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Yeelight-Control-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Yeelight-Control-Portable-${version}.${ext}"
    }
  }
}
